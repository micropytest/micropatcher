{
  "v": "2026.6.0",
  "name": "micropatcher",
  "desc": "A lightweight lib for patching things on micro:Pytest and MicroPython.",
  "keywords": [
    "mocking",
    "patching",
    "testing"
  ],
  "urls": {
    "homepage": "https://micropytest.com",
    "git": "https://github.com/micropytest/micropatcher",
    "issues": "https://github.com/micropytest/micropatcher/issues"
  },
  "src": {
    "dir": "micropatcher",
    "include": [
      "__init__.py",
      "_manifest.py",
      "_patcher.py"
    ]
  },
  "deps": {
    "dir": "deps/lib",
    "prod": [
    ],
    "dev": [
      "lib://unittest",
      "lib://unittest-discover",
      "mpmi@micropytest://should"
    ]
  },
  "mpmi": {
    "indexes": {
      "micropytest": "github://micropytest"
    }
  },
  "scripts": {
    "build": {
      "desc": "Prepares the package for its publish",
      "env": {
        ".env": true
      },
      "params": {
        "segment": {
          "desc": "Version segment to increment: major, minor, patch.",
          "type": "str",
          "value": ""
        }
      },
      "run": [
        "[ -n \"{segment}\" ] && micropython -m mpm inc-v {segment} || exit 0",
        "micropython -m mpm _manifest",
        "micropython -m mpm sync",
        "micropython -m mpm mpy-cross --from-zero",
        "micropython -m mpm mpy"
      ]
    },
    "tests": {
      "desc": "Runs the tests.",
      "env": {
        ".env": true
      },
      "run": "scripts/tests"
    }
  }
}
