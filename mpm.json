{
  "v": "0.1.0",
  "name": "micropatcher",
  "desc": "A lightweight lib for patching things on micro:Pytest and MicroPython.",
  "keywords": ["mocking", "patching", "testing"],
  "urls": {
    "homepage": "https://micropytest.com",
    "git": "https://github.com/micropytest/micropatcher",
    "issues": "https://github.com/micropytest/micropatcher/issues"
  },

  "src": {
    "dir": "micropatcher",
    "include": ["__init__.py", "_patcher.py"]
  },

  "deps": {
    "dir": "lib",
    "prod": {},
    "dev": {
      "should": "github://micropytest/should",
      "unittest": "lib://unittest",
      "unittest-discover": "lib://unittest-discover"
    }
  }
}
